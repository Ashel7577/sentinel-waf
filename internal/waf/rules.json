[
  {"id": 9001, "name": "Log4Shell JNDI / lookup injection", "category": "rce",
   "prefilter": ["${"],
   "pattern": "\\$\\{(?:jndi|lower|upper|env|sys|java|date|main|base64|ctx|map|sd|web|docker|k8s|spring)\\s*:|\\$\\{::-"},
  {"id": 9002, "name": "Template injection arithmetic probe", "category": "ssti",
   "prefilter": ["{{", "${", "<%", "#{"],
   "pattern": "\\{\\{\\s*\\d+\\s*[*+/-]\\s*\\d+\\s*\\}\\}|\\$\\{\\s*\\d+\\s*[*+/-]\\s*\\d+\\s*\\}|<%=?\\s*\\d+\\s*[*+/-]\\s*\\d+\\s*%>|#\\{\\s*\\d+\\s*[*+/-]\\s*\\d+\\s*\\}|\\{\\{=\\s*\\d+\\s*\\*"},
  {"id": 9003, "name": "Server-side template injection object access", "category": "ssti",
   "prefilter": ["{{", "{%", "<#assign", "freemarker.template", "${"],
   "pattern": "\\{\\{.*?(?:__class__|__mro__|__subclasses__|__globals__|__builtins__|__init__|config\\.|self\\.|request\\.application|cycler|lipsum|joiner|namespace|\\|attr).*?\\}\\}|\\{%.*?(?:import|os\\.|popen|subprocess).*?%\\}|<#assign|freemarker\\.template|\\$\\{.*?\\.getclass\\(\\)"},
  {"id": 9004, "name": "PHP code injection", "category": "rce",
   "prefilter": ["<?", "system", "passthru", "shell_exec", "proc_open", "popen", "pcntl_exec", "assert", "create_function", "call_user_func", "preg_replace", "eval", "$_"],
   "pattern": "<\\?(?:php|=)|\\b(?:system|passthru|shell_exec|proc_open|popen|pcntl_exec|assert|create_function|call_user_func(?:_array)?|preg_replace)\\s*\\(\\s*[\\x22'$]|\\beval\\s*\\(\\s*(?:base64_decode|gzinflate|str_rot13|\\$_)|\\$_(?:get|post|request|cookie|server)\\["},
  {"id": 9005, "name": "Java / OGNL / SpEL expression injection", "category": "rce",
   "prefilter": ["${", "%{", "java.lang", "t(java.", "#_memberaccess", "@java.lang"],
   "pattern": "\\$\\{.*?(?:runtime|processbuilder|getclass|classloader|forname).*?\\}|%\\{.*?#.*?\\}|\\bjava\\.lang\\.(?:runtime|processbuilder|system)|\\bt\\(java\\.|#_memberaccess|@java\\.lang"},
  {"id": 9006, "name": "XML external entity (XXE)", "category": "xxe",
   "prefilter": ["<!"],
   "pattern": "<!(?:doctype|entity)[^>]*(?:system|public|\\[)|<!entity\\s"},
  {"id": 9007, "name": "SSRF to cloud metadata service", "category": "ssrf",
   "prefilter": ["169.254.169.254", "metadata.google.internal", "100.100.100.200", "fd00:ec2::254", "169.254.170.2", "0xa9fea9fe", "2852039166"],
   "pattern": "169\\.254\\.169\\.254|metadata\\.google\\.internal|100\\.100\\.100\\.200|fd00:ec2::254|169\\.254\\.170\\.2|\\b0xa9fea9fe\\b|\\b2852039166\\b"},
  {"id": 9008, "name": "SSRF / smuggling URL scheme", "category": "ssrf",
   "prefilter": ["://"],
   "pattern": "\\b(?:gopher|dict|ldap|ldaps|tftp|netdoc|jar|sftp)://"},
  {"id": 9009, "name": "NoSQL operator injection", "category": "nosqli",
   "targets": ["key"], "prefilter": ["$"],
   "pattern": "(?:^|\\[)\\$(?:ne|eq|gt|gte|lt|lte|in|nin|regex|where|exists|expr|or|and|not|nor|elemmatch|function|accumulator)\\]?$"},
  {"id": 9010, "name": "NoSQL JavaScript injection", "category": "nosqli",
   "prefilter": ["$where", "this.", "db.", "sleep"],
   "pattern": "\\$where\\s*[\\x22':]|\\bthis\\.\\w+\\s*(?:==|!=|\\.match)|db\\.(?:getcollection|\\w+\\.find)\\(|\\bsleep\\s*\\(\\s*\\d{3,}\\s*\\)"},
  {"id": 9011, "name": "Security scanner user agent", "category": "scanner",
   "targets": ["header:user-agent"],
   "prefilter": ["sqlmap", "nikto", "nmap", "masscan", "acunetix", "nessus", "openvas", "wpscan", "gobuster", "dirbuster", "dirb", "nuclei", "zgrab", "havij", "w3af", "ffuf", "feroxbuster", "wfuzz", "commix", "xsstrike", "arachni", "skipfish", "jaeles", "netsparker", "appscan", "burpcollaborator", "interactsh"],
   "pattern": "\\b(?:sqlmap|nikto|nmap|masscan|acunetix|nessus|openvas|wpscan|gobuster|dirbuster|dirb|nuclei|zgrab|havij|w3af|ffuf|feroxbuster|wfuzz|commix|xsstrike|arachni|skipfish|jaeles|netsparker|appscan|burpcollaborator|interactsh)\\b"},
  {"id": 9012, "name": "CRLF / header injection", "category": "crlf", "raw": true,
   "prefilter": ["\r", "\n", "%0d", "%0a", "%e5%98", "\\r", "\\n"],
   "pattern": "(?i)(?:\\r|\\n|%0d|%0a|%e5%98%8a|%e5%98%8d|\\\\r|\\\\n)\\s*(?:set-cookie|location|content-type|content-length|refresh|x-[a-z-]+|bcc|cc|to|subject|http/1)\\s*:"},
  {"id": 9013, "name": "Shellshock function definition", "category": "rce",
   "prefilter": ["(){", "() {", "( ){", "( ) {"],
   "pattern": "\\(\\s*\\)\\s*\\{\\s*:?\\s*;?\\s*\\}\\s*;"},
  {"id": 9014, "name": "Prototype pollution", "category": "proto",
   "prefilter": ["__proto__", "prototype"],
   "pattern": "__proto__|constructor\\s*\\[\\s*[\\x22']?prototype|constructor\\.prototype"},
  {"id": 9015, "name": "LDAP filter injection", "category": "ldapi",
   "prefilter": ["*)", ")(", ") (", "(|", "(&", "( |", "( &"],
   "pattern": "\\*\\)\\s*\\(|\\)\\s*\\(\\s*[|&!]|\\(\\s*[|&]\\s*\\(\\s*\\w+\\s*="},
  {"id": 9016, "name": "Server-side include", "category": "ssi",
   "prefilter": ["<!--"],
   "pattern": "<!--\\s*#\\s*(?:exec|include|echo|config|printenv|set|fsize|flastmod)\\b"},
  {"id": 9017, "name": "Webshell / dangerous upload filename", "category": "upload",
   "targets": ["filename"],
   "pattern": "\\.(?:php\\d?|phtml|phar|jsp|jspx|asp|aspx|ashx|asmx|cer|cgi|pl|py|sh|exe|dll|bat|cmd|ps1|htaccess|war|svg)(?:[.\\s;%]|$)|\\.\\.[/\\\\]"},
  {"id": 9018, "name": "XPath injection", "category": "xpathi",
   "prefilter": ["|", "child::", "count", "string-length"],
   "pattern": "'\\s*\\]\\s*\\|\\s*//|/child::node\\(\\)|\\bcount\\s*\\(\\s*/|\\bstring-length\\s*\\(\\s*name\\s*\\(|\\]\\s*\\|\\s*//\\*"},
  {"id": 9019, "name": "Expression language probe", "category": "ssti",
   "prefilter": ["${", "#{"],
   "pattern": "\\$\\{\\s*[a-z_.]*(?:applicationscope|pagecontext|requestscope|sessionscope|header|param)\\b|#\\{\\s*(?:request|facescontext|session)\\b"},
  {"id": 9020, "name": "HTTP request smuggling in header value", "category": "smuggling", "raw": true,
   "targets": ["header", "header-std"], "prefilter": ["\u0000", "content-length", "transfer-encoding"],
   "pattern": "(?i)\\x00|\\bcontent-length\\s*:|\\btransfer-encoding\\s*:"}
]
